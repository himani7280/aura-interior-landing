{
  "name": "aura-interior-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"const fs = require('fs'); try { if (fs.existsSync('.next/BUILD_ID')) { fs.rmSync('.next', { recursive: true, force: true }); } fs.mkdirSync('.next/static/development', { recursive: true }); } catch {}\"",
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0"
  },
  "postcss": {
    "plugins": {
      "tailwindcss": {},
      "autoprefixer": {}
    }
  }
}
